<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <Button
        android:id="@+id/portal_cancel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical|start"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:text="取消" />

    <TextView
        android:id="@+id/portal_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.25"
        android:paddingBottom="8dp"
        android:text="填写验证码并登录。看到课表后，点底部「读取并识别」。"
        android:textColor="#1A1A1A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/portal_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.3"
        android:paddingBottom="8dp"
        android:textColor="#8B1A1A"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/portal_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/portal_extract"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:text="读取并识别" />
</LinearLayout>
