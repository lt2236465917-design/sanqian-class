+def manual_lines(path):
+    lines = []
+    for pid, raw in enumerate(path.read_text().splitlines()):
+        if not raw.strip(): continue
+        level = len(raw) - len(raw.lstrip('#')) if raw.startswith('#') else 0
+        text = raw.lstrip('#').strip() if level else raw.strip()
+        size = 13 if level == 1 else 11.5 if level == 2 else 10.5
+        if not level and not re.match(r'^\d+ ', text):
+            text = '　　' + text
+        for n, line in enumerate(wrap(text, size, RIGHT-LEFT)):
+            lines.append({'text': line, 'size': size, 'heading': bool(level), 'first': n == 0, 'paragraph': pid})
+    # Balance the complete document into real text lines, without blank or repeated filler.
+    page_count = max(1, math.ceil(len(lines) / 39))
+    pages, cursor = [], 0
+    for i in range(page_count):
+        count = math.ceil((len(lines)-cursor)/(page_count-i))
+        if cursor+count < len(lines) and lines[cursor+count-1]['heading']:
+            count -= 1
+        if cursor+count < len(lines) and lines[cursor+count-1]['paragraph'] == lines[cursor+count]['paragraph']:
+            start = cursor+count-1
+            while start > cursor and lines[start-1]['paragraph'] == lines[start]['paragraph']:
+                start -= 1
+            if start-cursor >= 30:
+                count = start-cursor
+        pages.append(lines[cursor:cursor+count]); cursor += count
+    assert cursor == len(lines)
+    assert page_count == 1 or min(map(len, pages)) >= 30, [len(p) for p in pages]
+    return pages
