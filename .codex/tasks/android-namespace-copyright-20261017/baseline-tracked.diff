div><div class='code'><span class='num'>27038</span><span>                    SchoolPortalTableCell(</span></div><div class='code'><span class='num'>27039</span><span>                        text = text,</span></div><div class='code'><span class='num'>27040</span><span>                        rowSpan = attribute(attrs, &quot;rowspan&quot;) ?: 1,</span></div><div class='code'><span class='num'>27041</span><span>                        colSpan = attribute(attrs, &quot;colspan&quot;) ?: 1</span></div><div class='code'><span class='num'>27042</span><span>                    )</span></div><div class='code'><span class='num'>27043</span><span>                )</span></div><div class='code'><span class='num'>27044</span><span>            }</span></div><div class='code'><span class='num'>27045</span><span>            if (cells.isNotEmpty()) rows.add(cells)</span></div><div class='code'><span class='num'>27046</span><span>        }</span></div><div class='code'><span class='num'>27047</span><span>        return rows</span></div><div class='code'><span class='num'>27048</span><span>    }</span></div><div class='code'><span class='num'>27049</span><span>    private fun stripTags(text: String): String {</span></div><div class='code'><span class='num'>27050</span><span>        var value = text</span></div><div class='code'><span class='num'>27051</span><span>        val drop = listOf(</span></div><div class='code'><span class='num'>27052</span><span>            &quot;&quot;&quot;&lt;(?:script|style|textarea|select|form)\b[^&gt;]*&gt;.*?&lt;/(?:script|style|textarea|select|form)&gt;&quot;&quot;&quot;,</span></div><div class='code'><span class='num'>27053</span><span>            &quot;&quot;&quot;&lt;[^&gt;]+\b(?:hidden|aria-hidden=[&quot;&#x27;]true[&quot;&#x27;])[^&gt;]*&gt;.*?&lt;/[^&gt;]+&gt;&quot;&quot;&quot;</span></div><div class='code'><span class='num'>27054</span><span>        )</span></div><div class='code'><span class='num'>27055</span><span>        for (pattern in drop) {</span></div><div class='code'><span class='num'>27056</span><span>            value = Regex(pattern, setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL)).replace(value, &quot;&quot;)</span></div><div class='code'><span class='num'>27057</span><span>        }</span></div><div class='code'><span class='num'>27058</span><span>        value = Regex(&quot;&quot;&quot;&lt;br\s*/?&gt;&quot;&quot;&quot;, RegexOption.IGNORE_CASE).replace(value, &quot;\n&quot;)</span></div><div class='code'><span class='num'>27059</span><span>        return Regex(&quot;&quot;&quot;&lt;[^&gt;]+&gt;&quot;&quot;&quot;, setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL)).replace(value, &quot; &quot;)</span></div><div class='code'><span class='num'>27060</span><span>    }</span></div><div class='code'><span class='num'>27061</span><span>    private fun decodeEntities(text: String): String {</span></div><div class='code'><span class='num'>27062</span><span>        return text.replace(&quot;&amp;nbsp;&quot;, &quot; &quot;).replace(&quot;&amp;amp;&quot;, &quot;&amp;&quot;).replace(&quot;&amp;lt;&quot;, &quot;&lt;&quot;).replace(&quot;&amp;gt;&quot;, &quot;&gt;&quot;)</span></div><div class='code'><span class='num'>27063</span><span>    }</span></div><div class='code'><span class='num'>27064</span><span>    private fun attribute(attrs: String, name: String): Int? {</span></div><div class='code'><span class='num'>27065</span><span>        val match = Regex(&quot;&quot;&quot;\b$name\s*=\s*[&quot;&#x27;]?(\d+)&quot;&quot;&quot;, RegexOption.IGNORE_CASE).find(attrs) ?: return null</span></div><div class='code'><span class='num'>27066</span><span>        return match.groupValues.getOrNull(1)?.toIntOrNull()</span></div><div class='code'><span class='num'>27067</span><span>    }</span></div><div class='code'><span class='num'>27068</span><span>}</span></div><div class='code'><span class='num'>27069</span><span>package local.sanqian.schedule</span></div><div class='code'><span class='num