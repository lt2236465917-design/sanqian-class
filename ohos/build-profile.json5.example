{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "${OHOS_HOME}/config/default_ohos_beb2R7_SesHgy1vQMNVsuiLAGxWazM3AmhIWVkTJIZI=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "<set-locally>",
          "profile": "${OHOS_HOME}/config/default_ohos_beb2R7_SesHgy1vQMNVsuiLAGxWazM3AmhIWVkTJIZI=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "${OHOS_HOME}/config/default_ohos_beb2R7_SesHgy1vQMNVsuiLAGxWazM3AmhIWVkTJIZI=.p12",
          "storePassword": "<set-locally>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.0.0(20)",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        },
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}